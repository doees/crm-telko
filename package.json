{
  "name": "telecom-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && prisma generate --schema services/prisma/schema.prisma",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env src/server/worker.ts",
    "finance": "tsx --env-file-if-exists=.env services/start-finance.ts",
    "scm": "tsx --env-file-if-exists=.env services/start-scm.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "db:services": "node --env-file-if-exists=.env scripts/migrate-services.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:server": "node scripts/test-server.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
