# Documentation only. Generate private .env with: node scripts/setup-env.mjs YOUR_OWNED_DOMAIN
APP_DOMAIN=<your-owned-domain>
APP_ORIGIN=https://<your-owned-domain>
PORT=3100
CRM_DATABASE_NAME=crm
FINANCE_DATABASE_NAME=finance
SCM_DATABASE_NAME=scm
POSTGRES_PASSWORD=
CRM_DB_PASSWORD=
FINANCE_DB_PASSWORD=
SCM_DB_PASSWORD=
DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<crm-database>
FINANCE_DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<finance-database>
SCM_DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<scm-database>
SERVICE_DATABASE_URL=postgresql://<service-user>:<url-encoded-password>@<host>:5432/<service-database>
FINANCE_API_URL=http://127.0.0.1:4101
SCM_API_URL=http://127.0.0.1:4102
CRM_CALLBACK_BASE_URL=http://127.0.0.1:3100
FINANCE_SERVICE_TOKEN=
SCM_SERVICE_TOKEN=
FINANCE_WEBHOOK_SECRET=
SCM_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FINANCE_PORT=4101
SCM_PORT=4102
